{
  "name": "claude-g2-dashboard",
  "version": "1.0.0",
  "description": "Claude-powered custom dashboard for Even Realities G2",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "sim": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "qr": "evenhub qr --port 5173",
    "pack": "npm run build && evenhub pack app.json ./dist -o claude-dash.ehpk",
    "server": "wrangler dev --port 8787",
    "deploy": "wrangler deploy"
  },
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.164.0"
  }
}

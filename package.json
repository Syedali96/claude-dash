{
  "name": "claude-dash",
  "version": "1.0.0",
  "description": "A Claude-powered heads-up dashboard for Even Realities G2 glasses",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "sim": "evenhub-simulator http://localhost:5173 --automation-port 9898",
    "qr": "evenhub qr --port 5173",
    "pack": "npm run build && node scripts/local-config.mjs && evenhub pack app.local.json ./dist -o claude-dash.ehpk",
    "server": "node scripts/local-config.mjs && wrangler dev -c wrangler.local.jsonc --port 8787",
    "deploy": "node scripts/local-config.mjs && wrangler deploy -c wrangler.local.jsonc",
    "secrets": "node scripts/local-config.mjs && wrangler secret bulk .dev.vars -c wrangler.local.jsonc"
  },
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "@gabrielevierti/glyph": "github:gabrielevierti/glyph"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@types/node": "^22.20.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.164.0"
  }
}
